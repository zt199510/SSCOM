<Window x:Class="Sscom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sscom · 串口调试助手" Width="1060" Height="740" MinWidth="960" MinHeight="600"
        FontFamily="Microsoft YaHei UI" FontSize="13" Background="#F5F7FA"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <TextBlock Text="SSCOM" FontSize="24" FontWeight="SemiBold" Foreground="#17324D"/>
            <TextBlock Text="本地串口调试 · HEX / ASCII" Foreground="#526479" VerticalAlignment="Bottom" Margin="16,0,0,3"/>
        </DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#DCE2EA" BorderThickness="1" Padding="14" CornerRadius="6">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanConfigure}">
                        <StackPanel Width="150" Margin="0,0,12,0">
                            <TextBlock Text="串口" Margin="0,0,0,5"/>
                            <ComboBox AutomationProperties.Name="串口" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"/>
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,12,0">
                            <TextBlock Text="波特率（可输入）" Margin="0,0,0,5"/>
                            <ComboBox AutomationProperties.Name="波特率" IsEditable="True" ItemsSource="{Binding BaudRates}" Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="刷新串口" Command="{Binding RefreshPortsCommand}" VerticalAlignment="Bottom"/>
                    <Button Content="{Binding OpenButtonText}" Command="{Binding TogglePortCommand}" Background="#1769AA" Foreground="White" VerticalAlignment="Bottom"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0" IsEnabled="{Binding CanConfigure}">
                    <TextBlock Text="数据位" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox AutomationProperties.Name="数据位" Width="62" ItemsSource="{Binding DataBitOptions}" SelectedItem="{Binding DataBits}"/>
                    <TextBlock Text="停止位" VerticalAlignment="Center" Margin="18,0,8,0"/>
                    <ComboBox AutomationProperties.Name="停止位" Width="80" ItemsSource="{Binding StopBitOptions}" SelectedIndex="{Binding StopBitIndex}"/>
                    <TextBlock Text="校验" VerticalAlignment="Center" Margin="18,0,8,0"/>
                    <ComboBox AutomationProperties.Name="校验" Width="95" ItemsSource="{Binding ParityOptions}" SelectedIndex="{Binding ParityIndex}"/>
                    <TextBlock Text="流控" VerticalAlignment="Center" Margin="18,0,8,0"/>
                    <ComboBox AutomationProperties.Name="流控" Width="220" ItemsSource="{Binding HandshakeOptions}" SelectedIndex="{Binding HandshakeIndex}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,16,0,8">
            <TextBlock Text="接收数据" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox Content="跟随最新数据" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <ComboBox AutomationProperties.Name="接收视图" Width="125" ItemsSource="{Binding DisplayModes}" SelectedIndex="{Binding DisplayMode}"/>
            </StackPanel>
        </DockPanel>
        <ListView x:Name="ReceiveList" Grid.Row="3" ItemsSource="{Binding Rows}"
                  FontFamily="Consolas" FontSize="14" BorderBrush="#DCE2EA"
                  ScrollViewer.CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel">
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="偏移" Width="90" DisplayMemberBinding="{Binding OffsetText}"/>
                    <GridViewColumn Header="HEX" Width="{Binding HexColumnWidth}" DisplayMemberBinding="{Binding Hex}"/>
                    <GridViewColumn Header="ASCII" Width="{Binding AsciiColumnWidth}" DisplayMemberBinding="{Binding Ascii}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Border Grid.Row="4" Background="White" BorderBrush="#DCE2EA" BorderThickness="1" Padding="12" Margin="0,12,0,0" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="手动发送 · 不自动追加换行" Foreground="#526479" Margin="0,0,0,8"/>
                <DockPanel>
                    <ComboBox DockPanel.Dock="Left" Width="90" Margin="0,0,10,0" AutomationProperties.Name="发送格式" ItemsSource="{Binding SendModes}" SelectedIndex="{Binding SendMode}"/>
                    <Button DockPanel.Dock="Right" Content="发送" Command="{Binding SendCommand}"/>
                    <TextBox AutomationProperties.Name="发送内容" Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="14" Padding="7,5" VerticalContentAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#334B63" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="接收 "/><TextBlock Text="{Binding ReceivedBytes, StringFormat={}{0:N0}}" FontWeight="SemiBold"/><TextBlock Text=" 字节"/>
                <TextBlock Text="    发送 "/><TextBlock Text="{Binding SentBytes, StringFormat={}{0:N0}}" FontWeight="SemiBold"/><TextBlock Text=" 字节"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
